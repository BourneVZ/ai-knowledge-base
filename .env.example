# ─────────────────────────────────────────────────────────────
# AI 知识库 · 环境变量配置模板
# ─────────────────────────────────────────────────────────────
# 复制此文件为 .env，填入真实值后即可使用。
# .env 已加入 .gitignore，不会被提交到仓库。
# ─────────────────────────────────────────────────────────────

# ---------- 模型提供商 ----------
# 可选值: deepseek | qwen | openai
LLM_PROVIDER=deepseek

# ---------- 通用 API Key（fallback） ----------
# 优先级低于各提供商的专属 Key，可用于单 Provider 场景
LLM_API_KEY=sk-your-key-here

# ---------- 提供商专属 API Key ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key
OPENAI_API_KEY=sk-your-openai-key

# ---------- 自定义端点（可选，覆盖默认值） ----------
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 默认模型（可选） ----------
# DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# QWEN_DEFAULT_MODEL=qwen-plus
# OPENAI_DEFAULT_MODEL=gpt-4o

# ---------- 请求配置 ----------
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# ---------- 预算守卫（CostGuard） ----------
# 单次流水线运行的 LLM 累计成本上限（元）；
# core.llm.chat 每次调用后累计成本，超出即抛 BudgetExceededError 熔断流水线
# BUDGET_YUAN=1.0

# ---------- 自定义定价（可选，$/1K tokens） ----------
# 覆盖成本估算器的默认单价；CostGuard 熔断阈值使用代码内置的人民币计价表，不受此处影响
# DEEPSEEK_INPUT_PRICE=0.00014
# DEEPSEEK_OUTPUT_PRICE=0.00028
# QWEN_INPUT_PRICE=0.00050
# QWEN_OUTPUT_PRICE=0.00200
# OPENAI_INPUT_PRICE=0.00250
# OPENAI_OUTPUT_PRICE=0.01000

# ---------- GitHub API ----------
# 本地运行 workflows/collector.py 抓 GitHub 时使用（提高 API 限额）；
# GitHub Actions 里由 secrets.GITHUB_TOKEN 自动注入，无需写入 .env
# GITHUB_TOKEN=ghp-your-github-token

# ---------- 分发渠道（v4-production/distribution，不推送可整段留空） ----------
# Telegram Bot：找 @BotFather 创建 bot 后获得的 token
# TELEGRAM_BOT_TOKEN=1234567890:AA-your-telegram-bot-token
# 接收消息的会话 id：找 @userinfobot 获取自己的 id；群组为负数 id（需先把 bot 拉入群）
# TELEGRAM_CHAT_ID=123456789
# 企业微信群机器人 webhook：群设置 -> 群机器人 -> 添加机器人 -> 复制 Webhook 地址
# WEIXIN_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key
# Telegram API 国内被墙，需 http 代理（如 Clash 混合端口）；直连环境留空即可
# TELEGRAM_PROXY=http://127.0.0.1:7890
